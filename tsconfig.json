{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"],
    "declaration": false,
    "sourceMap": true
  },
  "include": ["server.ts", "src/**/*", "api/**/*"],
  "exclude": ["node_modules", "dist", "src/scripts"]
}
